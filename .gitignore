# Dependencies
node_modules/

# Build output
out/
out-*/
dist/
*.tsbuildinfo

# Logs & OS cruft
*.log
.DS_Store
tmp/

# electron-builder trial/override configs
electron-builder.trial.yml
dev-app-update.yml

# Playwright artifacts
playwright-report/
test-results/

# ai-memory built from native/memory: bun run build:memory puts the binary and its build record here (never committed)
resources/ai-memory-bin/
# agent-desktop's pinned release (scripts/agent-desktop-pin.json): bun run build:agent-desktop unpacks it here (never committed)
resources/agent-desktop-bin/
# OMPdesk's own Rust built from native/ompdesk: bun run build:native puts the binaries and their build record here (never committed)
resources/ompdesk-bin/
# The Node runtime the shell build starts main with (scripts/node-runtime-pin.json): bun run build:node puts node and its record here (never committed)
resources/node/
# The CEF shell built from native/ompdesk/crates/shell: bun run build:shell stages it here (never committed)
resources/ompdesk-shell/
# CEF's CREDITS.html and LICENSE.txt out of its archive: bun run stage:cef-licenses (never committed)
resources/shell-licenses/
