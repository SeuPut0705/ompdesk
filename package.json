{
  "name": "ompdesk",
  "version": "0.28.0",
  "author": "SeuPut <228744781+SeuPut0705@users.noreply.github.com>",
  "private": true,
  "type": "module",
  "description": "ompdesk: an unofficial desktop app for the omp coding agent, running on the system-installed omp",
  "repository": "github:SeuPut0705/ompdesk",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "bun scripts/build-cache.ts",
    "preview": "electron-vite preview",
    "package": "bun run build && electron-builder",
    "package:mac": "bun run build && electron-builder --mac --arm64",
    "package:win": "bun run build && electron-builder --config electron-builder.win.yml --win --x64",
    "gen:icons": "bun scripts/gen-icons.ts",
    "check": "node scripts/lint-surfaces.mjs && biome check . && tsc --noEmit",
    "check:types": "tsc --noEmit",
    "lint": "biome lint .",
    "fix": "biome check --write --unsafe .",
    "fmt": "biome format --write .",
    "test": "vitest run",
    "test:platform": "vitest run --exclude \"src/renderer/**\"",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gate": "bun scripts/gate.ts",
    "locked": "bun scripts/build-lock.ts",
    "lock-stats": "bun scripts/lock-stats.ts",
    "bench": "vitest bench",
    "package:win:dir": "bun run build && electron-builder --config electron-builder.win.yml --win --x64 --dir"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/lang-markdown": "6.5.1",
    "@codemirror/view": "^6.36.0",
    "@dnd-kit/core": "^6.3.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tanstack/react-virtual": "^3.13.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "chart.js": "^4.4.0",
    "chokidar": "^4.0.0",
    "date-fns": "^4.1.0",
    "diff": "^9.0.0",
    "docx-preview": "0.4.1",
    "electron-log": "^5.3.0",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.11.0",
    "jszip": "3.10.2",
    "katex": "^0.16.0",
    "lucide-react": "^0.500.0",
    "mermaid": "^11.0.0",
    "micromark-factory-space": "2.0.1",
    "micromark-util-character": "2.1.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "react-markdown": "^10.0.0",
    "rehype-katex": "^7.0.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "6.0.0",
    "yaml": "^2.9.1",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "36.9.5",
    "electron-builder": "^26.0.0",
    "electron-vite": "^3.0.0",
    "linkedom": "^0.18.13",
    "micromark-extension-math": "3.1.0",
    "micromark-util-types": "2.0.2",
    "remark-parse": "11.0.0",
    "sharp": "0.34.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0",
    "unified": "11.0.5",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
