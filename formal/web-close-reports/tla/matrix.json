{
	"runs": [
		{
			"name": "code-safety-all-invariants",
			"config": "MC.cfg",
			"expect": "pass",
			"deadlock": false
		},
		{
			"name": "a-release-is-reachable",
			"config": "MC_sanity_release.cfg",
			"expect": "invariant",
			"property": "NeverReleases",
			"deadlock": false
		},
		{
			"name": "a-dirty-refusal-is-reachable",
			"config": "MC_sanity_refuse.cfg",
			"expect": "invariant",
			"property": "NeverRefuses",
			"deadlock": false
		},
		{
			"name": "suspected-late-dirty-report-between-decision-and-release",
			"config": "MC_late.cfg",
			"expect": "invariant",
			"property": "NoLateDirtyRelease",
			"deadlock": false
		}
	]
}
