{
	"runs": [
		{ "name": "code-safety-all-invariants", "config": "MC.cfg", "expect": "pass" },
		{ "name": "liveness-wait-and-probe-end", "config": "MC_live.cfg", "expect": "pass", "timeoutSec": 600 },
		{ "name": "liveness-limit-wait-goes-on", "config": "MC_live_limit.cfg", "expect": "pass", "timeoutSec": 600 },
		{ "name": "liveness-wait-and-probe-end-with-moves", "config": "MC_live_move.cfg", "expect": "pass", "tier": "deep", "timeoutSec": 4800 },
		{ "name": "a-wait-is-reachable", "config": "MC_sanity_wait.cfg", "expect": "invariant", "property": "NeverWaits" },
		{ "name": "a-retry-is-sent", "config": "MC_sanity_retry.cfg", "expect": "invariant", "property": "NeverRetries" },
		{ "name": "a-retry-is-armed", "config": "MC_sanity_armed.cfg", "expect": "invariant", "property": "NeverArmed" },
		{ "name": "a-retry-is-armed-past-the-attempt-count", "config": "MC_sanity_cap.cfg", "expect": "invariant", "property": "NeverArmedPastCount" },
		{ "name": "a-limit-wait-holds-while-the-tab-runs", "config": "MC_sanity_limit.cfg", "expect": "invariant", "property": "NeverLimitHeldBusy" },
		{ "name": "a-probe-row-shows", "config": "MC_sanity_probe.cfg", "expect": "invariant", "property": "NeverProbing" },
		{ "name": "a-relaunch-wait-is-reachable", "config": "MC_sanity_launch.cfg", "expect": "invariant", "property": "NeverLaunchWaits" },
		{ "name": "a-launch-restore-is-in-flight", "config": "MC_sanity_restore.cfg", "expect": "invariant", "property": "NeverRestores" },
		{ "name": "a-move-is-in-flight", "config": "MC_sanity_move.cfg", "expect": "invariant", "property": "NeverMoveInFlight" },
		{ "name": "a-continuation-waits-for-a-move", "config": "MC_sanity_defer.cfg", "expect": "invariant", "property": "NeverDeferredByMove" },
		{ "name": "a-person-prompts-while-a-continuation-waits", "config": "MC_sanity_pk.cfg", "expect": "invariant", "property": "NeverPromptedDeferred" },
		{ "name": "a-person-prompts-while-the-restore-runs", "config": "MC_sanity_rk.cfg", "expect": "invariant", "property": "NeverPromptedRestore" },
		{ "name": "deep-all-invariants-2-flaps", "config": "MC_deep.cfg", "expect": "pass", "tier": "deep", "timeoutSec": 4800 }
	]
