    { "name": "overlapping-deletes-reachable", "config": "MC_sanity_overlap.cfg", "expect": "invariant", "property": "NeverOverlap", "timeoutSec": 7200 },
    { "name": "failed-delete-reachable", "config": "MC_sanity_failure.cfg", "expect": "invariant", "property": "NeverFailed", "timeoutSec": 7200 },
    { "name": "reconnect-read-reachable-after-delete", "config": "MC_sanity_reconnect.cfg", "expect": "invariant", "property": "NeverRebuilt", "timeoutSec": 7200 },
